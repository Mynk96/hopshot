// Cloudflare deploy config for the hopshot.xyz landing page.
// Workers Builds runs `npx wrangler deploy` on every push to main and serves
// the static files in marketing/site. "name" must match the Worker's name in
// the Cloudflare dashboard.
{
	"name": "hopshot",
	"compatibility_date": "2026-10-01",
	"assets": {
		"directory": "./marketing/site"
	},
	"d1_databases": [
		{
			"binding": "hopshot",
			"database_name": "hopshot",
			"database_id": "8f9c769d-9d3a-4e3f-ae2f-5cea7d0fd52d",
			"remote": true
		}
	],
	"r2_buckets": [
		{
			"bucket_name": "hopshot-blobs",
			"binding": "hopshot_blobs",
			"remote": true
		}
	]
}