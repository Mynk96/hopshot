---
import "../styles/global.css";

interface Props {
  title: string;
  description?: string;
}

const { title, description = "Screenshots that clean up after themselves." } = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
  </head>
  <body class="min-h-dvh bg-surface-solid text-text">
    <slot />
  </body>
</html>
