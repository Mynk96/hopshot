---
import Base from "../../layouts/Base.astro";
import PhoneApp from "../../components/PhoneApp.tsx";

/*
 * The phone app (DESIGN S5, ARCHITECTURE §8).
 *
 * `client:only` because every decision here needs IndexedDB, the vault key and
 * `navigator` — none of which exist at build time. Server-rendering the shell would flash
 * "not paired" at an already-paired user on every launch.
 *
 * Prerendered: it is a static shell the service worker caches, and all the data arrives
 * client-side from the API.
 */
---

<Base title="Hopshot" noindex appShell>
  <PhoneApp client:only="react" />

  <script is:inline>
    // Registered here rather than in the island so the worker is installing while React is
    // still hydrating — on a cold Home Screen launch that is most of the startup time.
    if ("serviceWorker" in navigator) {
      window.addEventListener("load", () => {
        navigator.serviceWorker.register("/sw.js").catch((error) => {
          // An app that cannot cache its shell still works online; it is not worth failing.
          console.warn("the service worker did not register", error);
        });
      });
    }
  </script>
</Base>
