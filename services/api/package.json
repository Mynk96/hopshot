{
  "name": "api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev -c wrangler.toml",
    "deploy": "wrangler deploy -c wrangler.toml",
    "test": "vitest run",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "cf-typegen": "wrangler types -c wrangler.toml",
    "db:migrate:local": "wrangler d1 migrations apply DB --local -c wrangler.toml",
    "db:migrate:remote": "wrangler d1 migrations apply DB --remote -c wrangler.toml"
  },
  "dependencies": {
    "hono": "^4.13.12",
    "shared": "workspace:*"
  },
  "devDependencies": {
    "@cloudflare/vitest-pool-workers": "^0.22.0",
    "@types/node": "^26.6.4",
    "vitest": "^4.1.11",
    "wrangler": "^4.147.0"
  }
}
